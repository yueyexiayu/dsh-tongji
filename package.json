{
  "name": "tongji",
  "version": "0.1.52",
  "private": true,
  "type": "module",
  "description": "DSH 会话可观测性面板：统计、上下文、编队与跨会话洞察。",
  "license": "Apache-2.0",
  "author": "yueyexiayu <yueyexiayu@users.noreply.github.com>",
  "homepage": "https://github.com/yueyexiayu/dsh-tongji#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yueyexiayu/dsh-tongji.git"
  },
  "bugs": {
    "url": "https://github.com/yueyexiayu/dsh-tongji/issues"
  },
  "main": "lib/index.js",
  "scripts": {
    "build": "tsdown",
    "check": "node --check lib/index.js && node --check lib/usage.js && node --check lib/client.js",
    "test": "node --test tests/*.test.js",
    "typecheck": "tsc --noEmit",
    "verify": "npm run check && npm run typecheck && npm test"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json"
  },
  "devDependencies": {
    "zod": "^4.6.6",
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-client-store": "0.2.2-rc.5",
    "@deepseek-ai/dsh-error": "0.2.2-rc.5",
    "@deepseek-ai/dsh-scope": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.2-rc.5",
    "@deepseek-ai/dsh-session": "0.2.2-rc.5",
    "@deepseek-ai/dsh-session-projection": "0.2.2-rc.5",
    "@deepseek-ai/dsh-util-code-language": "0.2.2-rc.5",
    "@deepseek-ai/dsh-util-workspace-path": "0.2.2-rc.5",
    "@deepseek-ai/schemastery": "3.19.0",
    "@tailwindcss/node": "4.3.3",
    "@tailwindcss/oxide": "4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "anser": "^2.3.5",
    "clsx": "^2.1.1",
    "diff": "^9.0.0",
    "immer": "^10.2.0",
    "katex": "^0.16.47",
    "lightningcss": "1.32.0",
    "mdast-util-from-markdown": "^2.1.0",
    "mdast-util-gfm": "^3.1.0",
    "mdast-util-math": "^3.0.0",
    "micromark-core-commonmark": "^2.0.4",
    "micromark-extension-gfm": "^3.0.0",
    "micromark-extension-math": "^3.1.0",
    "micromark-factory-space": "^2.1.0",
    "micromark-util-character": "^2.1.1",
    "micromark-util-classify-character": "^2.0.1",
    "micromark-util-sanitize-uri": "^2.0.1",
    "micromark-util-symbol": "^2.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "semver": "^7.8.5",
    "shiki": "^4.5.0",
    "simple-icons": "16.32.0",
    "tsdown": "0.23.7",
    "typescript": "5.9.3",
    "zustand": "~4.4.7"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  }
}
